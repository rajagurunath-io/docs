                  },
                  "top_k": {
                    "anyOf": [
                      {
                        "minimum": -1,
                        "type": "integer"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "title": "Top K"
                  },
                  "frequency_penalty": {
                    "anyOf": [
                      {
                        "maximum": 2,
                        "minimum": -2,
                        "type": "number"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "title": "Frequency Penalty"
                  },
                  "presence_penalty": {
                    "anyOf": [
                      {
                        "maximum": 2,
                        "minimum": -2,
                        "type": "number"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "title": "Presence Penalty"
                  },
