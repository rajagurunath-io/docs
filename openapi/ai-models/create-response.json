                      {
                        "additionalProperties": false,
                        "properties": {
                          "effort": {
                            "anyOf": [
                              {
                                "enum": [
                                  "none",
                                  "minimal",
                                  "low",
                                  "medium",
                                  "high",
                                  "xhigh",
                                  "max"
                                ],
                                "type": "string"
                              },
                              {
                                "type": "null"
                              }
                            ],
                            "default": null,
                            "title": "Effort"
                          },
                          "enabled": {
                            "anyOf": [
                              {
                                "type": "boolean"
                              },
                              {
                                "type": "null"
                              }
                            ],
                            "default": null,
                            "title": "Enabled"
                          },
                          "summary": {
                            "anyOf": [
                              {
                                "enum": [
