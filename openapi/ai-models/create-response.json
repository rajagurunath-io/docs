                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "title": "Previous Response Id"
                  },
                  "conversation": {
                    "default": null,
                    "title": "Conversation"
                  },
                  "tools": {
                    "items": {
                      "additionalProperties": true,
                      "type": "object"
                    },
                    "maxItems": 128,
                    "title": "Tools",
                    "type": "array"
                  },
                  "tool_choice": {
                    "anyOf": [
                      {
                        "enum": [
                          "auto",
                          "none",
                          "required"
                        ],
                        "type": "string"
                      },
                      {
                        "additionalProperties": true,
                        "type": "object"
                      }
                    ],
                    "default": "auto",
                    "title": "Tool Choice"
                  },
                  "parallel_tool_calls": {
                    "default": true,
                    "title": "Parallel Tool Calls",
                    "type": "boolean"
                  },
                  "reasoning": {
