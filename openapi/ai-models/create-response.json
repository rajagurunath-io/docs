                              "type": "integer"
                            },
                            "total_tokens": {
                              "title": "Total Tokens",
                              "type": "integer"
                            },
                            "input_tokens_details": {
                              "additionalProperties": {
                                "type": "integer"
                              },
                              "title": "Input Tokens Details",
                              "type": "object"
                            },
                            "output_tokens_details": {
                              "additionalProperties": {
                                "type": "integer"
                              },
                              "title": "Output Tokens Details",
                              "type": "object"
