  "paths": {
    "/api/v1/responses": {
      "post": {
        "tags": [
          "OpenAI Compatible Developer API"
        ],
        "summary": "Create Response",
        "operationId": "create_response",
        "description": "Stateless text/function-tool Responses adapter. Availability and optional features depend on the selected model. Clients resend complete history; storage and server-managed conversation references are unsupported.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "model": {
                    "minLength": 1,
                    "title": "Model",
                    "type": "string"
                  },
                  "input": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "items": {
                          "additionalProperties": true,
                          "type": "object"
                        },
                        "type": "array"
                      }
                    ],
                    "title": "Input"
                  },
                  "instructions": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "title": "Instructions"
                  },
                  "stream": {
                    "default": false,
                    "title": "Stream",
                    "type": "boolean"
                  },
                  "store": {
                    "anyOf": [
                      {
                        "type": "boolean"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": false,
                    "title": "Store"
                  },
                  "background": {
