                "example": "event: response.created\ndata: {\"type\":\"response.created\",\"sequence_number\":0,\"response\":{\"id\":\"resp_example\",\"object\":\"response\",\"status\":\"in_progress\",\"output\":[],\"store\":false}}\n\n"
