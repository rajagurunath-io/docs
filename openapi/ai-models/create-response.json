                                  },
                                  "strict": {
                                    "anyOf": [
                                      {
                                        "type": "boolean"
                                      },
                                      {
                                        "type": "null"
                                      }
                                    ],
                                    "default": null,
                                    "title": "Strict"
                                  }
                                },
                                "title": "ResponsesTextFormat",
                                "type": "object"
                              },
                              {
                                "type": "null"
                              }
                            ],
                            "default": null
