                        },
                        "title": "ResponsesReasoning",
                        "type": "object"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null
                  },
                  "text": {
                    "anyOf": [
                      {
                        "additionalProperties": false,
                        "properties": {
                          "format": {
                            "anyOf": [
                              {
                                "additionalProperties": false,
                                "properties": {
                                  "type": {
                                    "default": "text",
                                    "enum": [
                                      "text",
                                      "json_object",
                                      "json_schema"
