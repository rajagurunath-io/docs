                    "metadata": {
                      "additionalProperties": {
                        "type": "string"
                      },
                      "title": "Metadata",
                      "type": "object"
                    }
                  },
                  "required": [
                    "id",
                    "created_at",
                    "model",
                    "status"
                  ],
                  "title": "ResponsesResponse",
                  "type": "object"
                }
              },
              "text/event-stream": {
                "schema": {
                  "type": "string"
